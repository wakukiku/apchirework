VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Existing VITE_SUPABASE_ANON_KEY is also supported. Never use service_role here.
# Optional: enable Cloudflare Turnstile in Supabase Auth and use the same public site key here.
VITE_TURNSTILE_SITE_KEY=

